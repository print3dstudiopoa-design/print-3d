generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id String @id @default(cuid())

  codigo Int @unique @default(autoincrement())

  nome String

  tempoEstimadoMinutos Int

  filamentoGramas Decimal @db.Decimal(10, 2)

  corPadrao String?

  observacao String?

  valorPadrao Decimal @db.Decimal(10, 2)

  valorCusto Decimal @default(0) @db.Decimal(10, 2)

  ativo Boolean @default(true)

  itens EncomendaItem[]

  categoria String?

  createdAt DateTime @default(now())

  updatedAt DateTime    @updatedAt
  VendaItem VendaItem[]
}

model Pessoa {
  id String @id @default(cuid())

  nome String

  dataNascimento DateTime?

  telefone String?

  email String?

  instagram String?

  facebook String?

  cidade String?

  bairro String?

  cpf String?

  observacao String?

  vendas Venda[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Configuracao {
  id String @id @default(cuid())

  percentualPerda Decimal @db.Decimal(5, 2)

  valorKwh Decimal @db.Decimal(10, 4)

  valorFilamentoKg Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cor {
  id String @id @default(cuid())

  nome String

  hexadecimal String?

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
}

model Encomenda {
  id String @id @default(cuid())

  codigo Int @unique @default(autoincrement())

  nomeCliente String

  telefoneCliente String?

  status StatusEncomenda @default(EM_FILA)

  dataEntrega DateTime?

  dataProducao DateTime?

  dataFinalizacao DateTime?

  dataEntregaReal DateTime?

  valorTotal Decimal @default(0) @db.Decimal(10, 2)

  observacao String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  itens EncomendaItem[]
}

model EncomendaItem {
  id String @id @default(cuid())

  encomendaId String

  encomenda Encomenda @relation(fields: [encomendaId], references: [id])

  produtoId String

  produto Produto @relation(fields: [produtoId], references: [id])

  quantidade Int @default(1)

  valorUnitario Decimal @db.Decimal(10, 2)

  valorTotal Decimal @db.Decimal(10, 2)

  cor1 String?

  cor2 String?

  cor3 String?

  observacao String?
}

enum StatusEncomenda {
  EM_FILA
  EM_PRODUCAO
  FINALIZADA
  CANCELADA
}

model Venda {
  id String @id @default(cuid())

  codigo Int @unique @default(autoincrement())

  pessoaId String?

  pessoa Pessoa? @relation(fields: [pessoaId],references: [id])

  dataPedido DateTime

  cliente String

  formaPagamento FormaPagamento

  observacao String?

  valorTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  itens VendaItem[]
}

model VendaItem {
  id String @id @default(cuid())

  vendaId String

  venda Venda @relation(fields: [vendaId], references: [id])

  produtoId String

  produto Produto @relation(fields: [produtoId], references: [id])

  quantidade Int

  valorUnitario Decimal @db.Decimal(10, 2)

  valorTotal Decimal @db.Decimal(10, 2)
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
}
